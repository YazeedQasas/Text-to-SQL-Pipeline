# Copy to .env (in the repo root, and/or backend/.env and ingestion/.env —
# both read from the same variable names) and fill in real values.

# --- MySQL (existing instance; use the read-only user from db/03_readonly_user.sql) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=texttosql_ro
MYSQL_PASSWORD=change_me_readonly_password
MYSQL_DATABASE=legal_db

# --- MySQL (application state: chat transcripts; db/07_app_schema.sql) ---
# A second account on the SAME instance, with DML on app_db and nothing else.
# Two things must stay true, and the backend refuses to start the store if
# either is broken:
#
#   APP_MYSQL_DATABASE != MYSQL_DATABASE — app_db is outside Debezium's include
#     list and outside the read-only user's grants. Put transcripts in legal_db
#     and CDC documents them into Qdrant, after which model-generated SQL can
#     read back what other people asked.
#   APP_MYSQL_USER != MYSQL_USER — MYSQL_USER executes model-generated SQL and
#     holds SELECT only. Granting it INSERT makes a bug in sql_guard.py a write
#     bug.
#
# Host and port default to the pipeline's values; it is one MySQL server.
APP_MYSQL_HOST=127.0.0.1
APP_MYSQL_PORT=3306
APP_MYSQL_USER=texttosql_app
APP_MYSQL_PASSWORD=change_me_app_password
APP_MYSQL_DATABASE=app_db

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=schema_docs
RETRIEVAL_TOP_K=5
# Domain glossary (data/concepts.json), kept in step by the concept sync.
# A concept matches if its term is written in the question (lexical, no
# threshold) OR the best-scoring fragment of the question clears
# CONCEPT_SCORE_THRESHOLD. The threshold is what makes the glossary abstain on
# questions containing no special term — re-measure it when concepts are added.
QDRANT_CONCEPTS_COLLECTION=legal_concepts
CONCEPT_TOP_K=3
CONCEPT_SCORE_THRESHOLD=0.60

# --- LM Studio (LLM + embeddings, OpenAI-compatible local server) ---
# Start via LM Studio > Developer > Start Server, with Gemma 4 E4B
# Instruct and BGE-M3 both loaded. Model IDs must exactly match what LM
# Studio reports at GET http://localhost:1234/v1/models -- check there if
# generation 404s.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-bge-m3
EMBEDDING_DIM=1024
LLM_MODEL=google/gemma-4-e4b

# --- Conversation context ---
# MUST match the context length the model is actually loaded with in LM Studio
# (Developer > loaded model > Context Length), not the model's maximum. Set it
# higher and overflow stops being a clean "start a new chat": LM Studio
# truncates the START of the prompt, which is the schema, and the model answers
# with invented column names.
CONTEXT_WINDOW_TOKENS=16000
# Head-room kept free for the model's reply.
CONTEXT_OUTPUT_RESERVE_TOKENS=800
# An abuse rail, not the memory limit -- the token budget above decides when a
# conversation is full. It must stay ABOVE the turns that budget allows (which
# grows with CONTEXT_WINDOW_TOKENS: roughly 560 turns at a 50k window). Set it
# lower and it silently drops the oldest turns instead of stopping cleanly.
#
# 0 or negative means NO MEMORY AT ALL, not "unlimited": every turn reaches the
# model as if it were the first. Use a positive value.
CONTEXT_MAX_TURNS=1000
# Tables carried over from the previous turn on top of RETRIEVAL_TOP_K, so a
# follow-up that names no table still sees the schema it depends on.
CONTEXT_CARRY_TABLES=3

# --- Query execution safety ---
MAX_RESULT_ROWS=200
SQL_STATEMENT_TIMEOUT_SECONDS=10

# --- Repeated-question cache (Redis) ---
# Keeps the SQL a question resolved to, so asking it again skips both the
# embedding call (~2.7s) and the SQL-generation completion. The stored query is
# RE-EXECUTED every time and the answer rewritten from the fresh rows, so a
# cached question never reports yesterday's numbers.
#
# Matching is lexical: the key is the question with diacritics, punctuation and
# the definite article folded away, so "ما هي القضايا المدورة؟" and "ما هي قضايا
# مدورة" are one entry. Nothing is matched by meaning — questions differing only
# by a year, a place or a negation must not collide, and embeddings barely
# separate those. Only first turns are cached; a follow-up depends on the turn
# before it. Cleared automatically whenever a table is documented or the
# glossary syncs.
#
# Redis is NOT load-bearing. If it is down every question is simply a miss and
# the pipeline runs as it did before this existed — start it with
# `docker compose up -d redis`, or set QUERY_CACHE_ENABLED=false to skip it.
QUERY_CACHE_ENABLED=true
# Whether a question asked partway through a chat may be answered from the
# cache. DEFAULTS FALSE.
#
# Entries are written from first turns only, but that gates the turn's POSITION,
# not the question's CONTENT -- nothing inspects the wording, so opening a fresh
# chat and asking "وكم منها مفتوحة؟" does write an anaphoric query to the cache.
# The lookup key is the question alone (no chat id, no history), so with this
# enabled a chat deep in one subject can be served SQL built for a different
# chat's cold opening. The answer is rewritten with the right history, so it
# reads plausibly; the query was chosen outside that context.
#
# Set true to buy back most of the hit rate -- first-turn-only means the cache
# rarely fires, since a real session is one long chat holding many unrelated
# self-contained questions -- accepting the above.
QUERY_CACHE_FOLLOW_UPS=false
REDIS_URL=redis://localhost:6379/0
# Namespaces every key this feature owns, so clearing the cache touches nothing
# else in a shared Redis. Never FLUSHDB.
QUERY_CACHE_PREFIX=querycache
# A ceiling, not a tuning knob — the realistic number of distinct questions is
# in the hundreds. This only stops an automated client growing the keyspace
# forever. Oldest entries are evicted first.
QUERY_CACHE_MAX_ENTRIES=5000
# Optional per-entry expiry, 0 to disable. Invalidation here is event-driven, so
# this is only a backstop for schema changes that arrive through neither CDC nor
# the approve flow — a column edited straight in MySQL with CDC switched off.
QUERY_CACHE_TTL_SECONDS=0
# Short on purpose: a cache that exists to save seconds must never add them. On
# timeout the turn is treated as a miss.
REDIS_TIMEOUT_SECONDS=2.0

# --- Schema catalog review ---
# Rows sampled per changed table and shown to the reviewing LLM. This is its
# main evidence for telling a real domain table from a scratch import, but it
# all goes into the prompt -- keep it small.
CATALOG_SAMPLE_ROWS=5
# Tables reviewed in parallel. Keep at 1 for LM Studio: concurrent completions
# from a single loaded model come back truncated, which makes every reviewed
# table fail closed with an empty description. Raise only on a backend that
# really supports parallel inference.
CATALOG_REVIEW_CONCURRENCY=1

# --- Legal concept file sync ---
# The JSON file users edit, and the snapshot that makes the sync three-way.
# Paths are relative to the repo root. Do not edit the snapshot by hand: it is
# what lets the sync tell "deleted from the file" apart from "added to Qdrant".
CONCEPTS_FILE=data/concepts.json
CONCEPTS_SYNC_STATE_FILE=data/.concepts-sync-state.json
# Refuse any sync that would delete more than this fraction of either side.
# Guards the accident that actually happens: Qdrant restarts on an empty volume,
# every concept looks deleted, and an unguarded reconcile empties concepts.json
# to match. Set to 1.0 to disable. The floor keeps small glossaries editable --
# removing 1 of 3 is 33% but obviously fine.
CONCEPT_SYNC_DELETE_RATIO=0.30
CONCEPT_SYNC_DELETE_FLOOR=4

# --- Qdrant deletion watcher ---
# Tails `docker logs` so a delete made in the Qdrant dashboard is mirrored back
# into concepts.json. The logs say a delete HAPPENED but not WHAT was deleted --
# point deletes appear as an access line with no request body -- so the watcher
# only triggers a full reconcile. Only REST (6333) is logged; a delete over gRPC
# is invisible. Set false if Qdrant is not running in Docker locally.
QDRANT_WATCH_ENABLED=true
QDRANT_CONTAINER=texttosql-qdrant
QDRANT_WATCH_DEBOUNCE_SECONDS=3.0

# --- Debezium CDC (automatic table documentation) ---
# Debezium Server tails the MySQL binlog and POSTs to /api/cdc/events.
# Start it with: docker compose --profile cdc up -d
CDC_ENABLED=true
# How long a newly-seen table waits before being documented. A CREATE TABLE
# arrives the instant it commits, when the table is still empty -- and sample
# rows are the reviewer's strongest evidence. Waiting lets the INSERTs land.
CDC_DEBOUNCE_SECONDS=20
# Ceiling on that wait, so a long bulk load cannot postpone it forever.
CDC_MAX_WAIT_SECONDS=120
# What the automated path documented, kept so it can be read and corrected --
# both flagged tables (not indexed) and ones it indexed on its own.
REVIEW_QUEUE_FILE=data/review-queue.json

# Debezium's own connection. It needs REPLICATION SLAVE / REPLICATION CLIENT /
# RELOAD, which the read-only query user deliberately does not have -- run
# db/06_cdc_user.sql, and check the server has log_bin=ON and binlog_format=ROW.
# Read from docker-compose.yml, not by the backend.
CDC_MYSQL_HOST=host.docker.internal
CDC_MYSQL_PORT=3306
CDC_MYSQL_USER=debezium
CDC_MYSQL_PASSWORD=change_me_cdc_password
# Must be unique across everything replicating from this MySQL server. A
# collision makes the server drop one connection at random, which presents as
# CDC silently stopping.
CDC_SERVER_ID=184054
CDC_SINK_URL=http://host.docker.internal:8000/api/cdc/events

# --- Activity log ---
# Append-only JSONL behind the Activity tab, plus how many events are held in
# memory for instant reads.
ACTIVITY_LOG_FILE=data/activity.jsonl
ACTIVITY_RING_SIZE=500

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
